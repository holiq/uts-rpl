@startuml Purchase Use Case Diagram

' Styling
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor LightBlue
skinparam usecaseBackgroundColor<<critical>> LightCoral

title Use Case Diagram - Modul Purchase

' Actors
actor "User" as user

' System boundary
rectangle "Sistem Purchase" {

    ' Main Purchase Flow
    usecase "Lihat Daftar Purchase" as UC1
    usecase "Buat Purchase Baru" as UC2
    usecase "Pilih Supplier" as UC3
    usecase "Tambah Item Produk" as UC4
    usecase "Input Qty & Harga" as UC5
    usecase "Simpan Purchase" as UC6
    usecase "Lihat Detail Purchase" as UC7
    usecase "Edit Purchase" as UC8
    usecase "Hapus Purchase" as UC9
    usecase "Update Stok (Stock In)" as UC10 <<critical>>
    usecase "Reverse Stock In" as UC11 <<critical>>
    usecase "Catat Transaksi" as UC12
}

' User relationships
user --> UC1
user --> UC2
user --> UC7
user --> UC8
user --> UC9

' Flow relationships - Create Purchase
UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>
UC2 ..> UC6 : <<include>>
UC6 ..> UC10 : <<include>>
UC10 ..> UC12 : <<include>>

' Flow relationships - Edit Purchase
UC8 ..> UC11 : <<include>>
UC8 ..> UC10 : <<include>>

' Flow relationships - Delete Purchase
UC9 ..> UC11 : <<include>>

note right of UC6
  Saat menyimpan purchase:
  1. Hitung total qty & total_price
  2. Buat record Purchase
  3. Buat record PurchaseItem untuk setiap item
  4. Update stok menggunakan StockService
end note

note right of UC10
  StockService.stockIn():
  - Tambah stok produk
  - Catat ProductTransaction
    dengan type = 'purchase'
end note

note right of UC11
  StockService.reverseStockIn():
  - Kembalikan stok yang sudah ditambah
  - Digunakan saat edit/delete purchase
end note

@enduml
